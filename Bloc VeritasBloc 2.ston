stX by the *kerned* width of the current\r\t\t\tcharacter, which is where the *next* char will go"\r\t\t\tfloatDestX := floatDestX + (kern * self scale)\r\t\t\t\t\t\t+ ((widthAndKernedWidth at: 2) * self scale).\r\t\t\t"if we are at the end of this run we keep track of the\r\t\t\tcharacter-kern-delta for possible later use and then rather\r\t\t\tinsanely remove that character-kern-delta from floatDestX,\r\t\t\tmaking it equivalent to (old floatDestX) + kernDelta +\r\t\t\twidth-of-character - no idea why"\r\t\t\tatEndOfRun\r\t\t\t\tifTrue: [pendingKernX := ((widthAndKernedWidth at: 2) * self scale)\r\t\t\t\t\t\t\t\t- ((widthAndKernedWidth at: 1) * self scale).\r\t\t\t\t\tfloatDestX := floatDestX - pendingKernX].\r\t\t\t"save the next x for next time around the loop"\r\t\t\tdestX := floatDestX.\r\t\t\tlastIndex := lastIndex + 1]',#bytecodeStart:128,#bytecodeEnd:258,#methodsActivated:[MethodActivatedModel{#compiledMethodName:'BlockClosure>>#whileTrue:',#receiverTypes:Bag{#FullBlockClosure:73}}],#selector:'whileTrue:'},CallSiteModel{#methodClassName:#TextMorph,#methodSelector:#'privateOwner:',#sourceStart:71,#sourceEnd:98,#source:'super privateOwner: newOwner',#bytecodeStart:67,#bytecodeEnd:69,#methodsActivated:[MethodActivatedModel{#compiledMethodName:'Morph>>#privateOwner:',#receiverTypes:Bag{#TextMorph:3}}],#selector:'privateOwner:'},CallSiteModel{#methodClassName:#CompositionScanner,#methodSelector:#'composeFrom:inRectangle:firstLine:leftSide:rightSide:',#sourceStart:951,#sourceEnd:965,#source:'(runLength - 1)',#bytecodeStart:265,#bytecodeEnd:265,#methodsActivated:[MethodActivatedModel{#compiledMethodName:'SmallInteger>>#-',#receiverTypes:Bag{#SmallInteger:25}}],#selector:'-'},CallSiteModel{#methodClassName:#SpGeometryStyle,#methodSelector:#'applyTo:',#sourceStart:246,#sourceEnd:334,#source:'self minWidthVariable\r\t\tifNotNil: [ :aVariable | aMorph minWidth: aVariable scaledValue ]',#bytecodeStart:203,#bytecodeEnd:214,#methodsActivated:[MethodActivatedModel{#compil